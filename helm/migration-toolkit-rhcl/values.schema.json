{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "backend": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          },
          "required": ["repository", "tag"]
        },
        "replicas": { "type": "integer", "minimum": 1 }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          },
          "required": ["repository", "tag"]
        },
        "replicas": { "type": "integer", "minimum": 1 }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "database": { "type": "string" }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "clusterAdmin": { "type": "boolean" }
      }
    }
  }
}
