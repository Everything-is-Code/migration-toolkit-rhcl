{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "backend": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          },
          "required": ["repository", "tag"]
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          },
          "required": ["repository", "tag"]
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "database": { "type": "string" },
        "existingSecret": { "type": "string" },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClassName": { "type": "string" }
          }
        },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "digest": { "type": "string" }
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "password": { "type": "string", "minLength": 1 }
          },
          "required": ["password"]
        },
        {
          "properties": {
            "existingSecret": { "type": "string", "minLength": 1 }
          },
          "required": ["existingSecret"]
        }
      ]
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "clusterAdmin": { "type": "boolean" }
      }
    }
  }
}
