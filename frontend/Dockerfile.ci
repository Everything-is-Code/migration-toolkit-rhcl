# Pin: node:22-alpine — refresh digests via CONTRIBUTING.md / AGENTS.md
FROM docker.io/library/node:26-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS builder
USER 0
WORKDIR /opt/app-root/src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Pin: ubi9/nginx-124:1
FROM registry.access.redhat.com/ubi9/nginx-124:1@sha256:d0dea12c26ab29734d15590f2a931180f68d6c276dffdf9e3f1e8eeb9ab3be59
COPY --from=builder /opt/app-root/src/build/ /opt/app-root/src/
COPY nginx/nginx.conf "${NGINX_CONF_PATH}"
EXPOSE 8080
USER 1001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
