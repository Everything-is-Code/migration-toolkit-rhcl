# Pin: node:26-alpine — refresh digests via CONTRIBUTING.md / AGENTS.md
FROM docker.io/library/node:26-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS builder
USER 0
WORKDIR /opt/app-root/src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Pin: ubi9/nginx-124:1
FROM registry.access.redhat.com/ubi9/nginx-124:1@sha256:d40ea11bb6174cda50424f4b0f25326a5d04335ae9008191a0194488d3c94444
COPY --from=builder /opt/app-root/src/build/ /opt/app-root/src/
COPY nginx/nginx.conf "${NGINX_CONF_PATH}"
EXPOSE 8080
USER 1001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
